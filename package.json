{
  "name": "uploadmylaser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kid-safe web sender for a Ruida laser, built for Chromebook classrooms.",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite web",
    "build": "vite build web",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "node --test \"test/*.test.mjs\" \"web/test/*.test.mjs\"",
    "test:py": "cd container && python -m pytest -q",
    "icons": "node scripts/make-icons.mjs web/public"
  },
