{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uploadmylaser",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-31",
  // uploadmylaser.com is the real address; www redirects to it (src/headers.ts). The workers.dev
  // URL is off: the Cache API (wrong-try lockouts) does nothing there, so it would skip them.
  "routes": [
    { "pattern": "uploadmylaser.com", "custom_domain": true },
    { "pattern": "www.uploadmylaser.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    // Every response, static files included, goes through the Worker for https + security headers.
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "kv_namespaces": [
    // This app's own namespace. Never reuse uploadmycode's.
    { "binding": "CLASS_KV", "id": "812c0c759168406aa12bc0470b50e986" }
  ],
  "vars": {
    "ALLOWED_CIDRS": ""
  },
  // TEACHER_KEY is a secret: npx wrangler secret put TEACHER_KEY
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "containers": [
    {
      "class_name": "LaserContainer",
      "image": "./container/Dockerfile",
      "image_build_context": "./container",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  // Per-IP fuses checked before the class phrase (src/ip-limit.ts), so phrases cannot be guessed
  // without limit. A school shares one IP, so each limit EQUALS the site-wide limit in
  // src/ratelimit.ts (400 a minute): never lower. namespace_id is unique across the whole account.
  "ratelimits": [
    { "name": "PROCESS_IP_LIMIT", "namespace_id": "20260940", "simple": { "limit": 400, "period": 60 } },
    { "name": "PHRASE_IP_LIMIT", "namespace_id": "20260941", "simple": { "limit": 400, "period": 60 } },
    // Counts WRONG class phrases only (src/wrong-ip.ts), so right phrases from a whole class never
    // count. uploadmylaser uses ids 9100-9199 for new limits.
    { "name": "WRONG_PHRASE_IP_LIMIT", "namespace_id": "9100", "simple": { "limit": 60, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PROCESSOR", "class_name": "LaserContainer" },
      // Rate limits + teacher-key guard. No container attached, on purpose (see src/worker.ts).
      { "name": "COUNTERS", "class_name": "Counters" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LaserContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["Counters"] }
  ]
}
